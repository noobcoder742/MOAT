            },
            {
              "id": "sql_p1l3q5",
              "kind": "choice",
              "prompt": "Show only the two cheapest drinks.",
              "code": "SELECT name FROM menu\nORDER BY price\n___ 2;",
              "options": [
                "LIMIT",
                "COUNT",
                "WHERE"
              ],
              "answer": [
                "LIMIT"
              ],
              "explanation": "LIMIT 2 stops after the first two rows."
            }
          ]
        },
        {
          "id": "sql_p1l4",
          "title": "Count and add",
          "questions": [
            {
              "id": "sql_p1l4q1",
              "kind": "choice",
              "prompt": "How many drinks are on the menu?",
