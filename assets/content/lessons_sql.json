              "explanation": "COUNT(*) counts the rows."
            },
            {
              "id": "sql_p1l4q2",
              "kind": "choice",
              "prompt": "What shows?",
              "code": "-- menu: Latte 4.50, Mocha 5.00, Tea 3.00\nSELECT SUM(price) FROM menu;",
              "options": [
                "3",
                "4.5",
                "12.5"
              ],
              "answer": [
                "12.5"
              ],
              "explanation": "SUM adds the prices up: 4.50 + 5.00 + 3.00 = 12.50.",
              "verify": "output"
            },
            {
              "id": "sql_p1l4q3",
              "kind": "build",
              "prompt": "Count the drinks. Build the query.",
              "options": [
                "SUM(*)",
                "FROM",
                ";",
                "COUNT(*)",
                "SELECT",
                "WHERE",
                "menu"
              ],
              "answer": [
                "SELECT",
                "COUNT(*)",
                "FROM",
                "menu",
                ";"
              ],
              "explanation": "COUNT(*) counts the rows in menu: 3 drinks."
            },
            {
              "id": "sql_p1l4q4",
              "kind": "bug",
              "prompt": "Tap the line with the mistake.",
              "options": [
                "SELECT COUNT(*) FROM menu;",
                "SELECT SUM(price) FROM menu;",
                "SELECT COUNT FROM menu;"
              ],
              "answer": [
                "SELECT COUNT FROM menu;"
              ],
              "explanation": "COUNT needs brackets. Fix: COUNT(*)",
              "verify": "bug",
              "fix": "SELECT COUNT(*) FROM menu;"
            },
            {
              "id": "sql_p1l4q5",
              "kind": "match",
              "prompt": "Match each function to what it gives.",
              "options": [
                "COUNT(*)",
                "SUM(price)",
                "MAX(price)",
                "MIN(price)"
              ],
              "answer": [
                "How many rows",
                "Add the prices up",
                "The biggest price",
                "The smallest price"
              ],
              "right": [
                "Add the prices up",
                "The biggest price",
                "The smallest price",
                "How many rows"
              ],
              "explanation": "COUNT counts rows, SUM adds, MAX finds the biggest, and MIN finds the smallest."
            }
          ]
        }
      ]
    }
  ]
