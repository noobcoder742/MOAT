              "picture": "⭐",
              "options": [
                "score + 5;",
                "score = score + 5;",
                "score = 5;"
              ],
              "answer": [
                "score = score + 5;"
              ],
              "explanation": "Take the old value, add 5, and put it back in the same box."
            },
            {
              "id": "javascript_p1l4q2",
              "kind": "choice",
              "prompt": "What shows?",
              "code": "let lives = 3;\nlives = lives - 1;\nconsole.log(lives);",
              "options": [
                "3",
                "4",
                "2"
              ],
              "answer": [
                "2"
              ],
              "explanation": "3 - 1 = 2.",
              "verify": "output"
            },
            {
              "id": "javascript_p1l4q3",
              "kind": "build",
              "prompt": "Build the score message.",
              "code": "let score = 3;",
              "options": [
                "\"score\"",
                "score",
                "console.log",
                "+",
                "\"Score: \"",
                "-",
                ")",
                ";",
                "("
              ],
              "answer": [
                "console.log",
                "(",
                "\"Score: \"",
                "+",
                "score",
                ")",
                ";"
              ],
              "explanation": "The + joins the text and the score, so the console shows Score: 3."
            },
            {
              "id": "javascript_p1l4q4",
              "kind": "bug",
              "prompt": "Tap the line with the mistake.",
              "options": [
                "let coins = 2;",
                "coins = coins +;",
                "console.log(coins);"
              ],
              "answer": [
                "coins = coins +;"
              ],
              "explanation": "The + needs a number after it. Fix: coins = coins + 3;",
              "verify": "bug",
              "fix": "coins = coins + 3;"
            },
            {
              "id": "javascript_p1l4q5",
              "kind": "match",
              "prompt": "Match each line to what it does to the score.",
              "options": [
                "score = score + 1;",
                "score = score - 1;",
                "score = score * 2;",
                "score = score + 10;"
              ],
              "answer": [
                "Add 1",
                "Take away 1",
                "Double it",
                "Add 10"
              ],
              "right": [
                "Take away 1",
                "Double it",
                "Add 10",
                "Add 1"
              ],
              "explanation": "+ adds, - takes away, and * multiplies. The new value goes back in the box."
